"SuperGram.App.FileLogging" = "Save App Logs";
"SuperGram.App.NetworkLogging" = "Network Logs";
"SuperGram.App.Logging.Notice" = "Logs help to diagnose problems but use storage and battery. Changes apply after restart.";

/* W2-GHOST */
"SuperGram.Ghost.Header" = "GHOST MODE";
"SuperGram.Ghost.SkipReadReceipts" = "Don't Send Read Receipts";
"SuperGram.Ghost.SkipReadReceipts.Notice" = "Messages you open stay unread for the sender and in your chat list, voice and round messages you play stay unlistened, reactions stay unseen. Replying, reacting or \"Mark as Read\" still reveal you. Secret chats and self-destructing media are not affected.";
"SuperGram.Ghost.StoryGhostMode" = "Ghost Story Viewing";
"SuperGram.Ghost.StoryGhostMode.Notice" = "Stories you watch are marked as seen only on this device, the author doesn't get your view. If you later watch a newer story of the same person with this option off, the earlier ones are reported too. Reactions and replies reveal you.";
"SuperGram.Ghost.Stories.Header" = "STORIES";
"SuperGram.Ghost.RepostToStory" = "Repost to Story in Share Menu";
"SuperGram.Ghost.WarnOnStoriesOpen.Notice" = "Ask Before Viewing shows a confirmation before someone's story starts playing, so a view is never sent by accident. Repost to Story in Share Menu adds the story row to the share sheet; turn it off so you never post to your story by mistake.";
"SuperGram.Ghost.ShowJoinedDate" = "Show Join Date";
"SuperGram.Ghost.Profiles.Notice" = "Tap the ID to copy it. The creation date of channels and groups and the date a member joined the group you came from need one extra request when a profile opens; the join date is asked again on every open, which is why it is off by default. The registration date is approximate and known only for some users.";
"SuperGram.Ghost.Calls.Header" = "CALLS";

