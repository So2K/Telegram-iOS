"SuperGram.Network.MusicRateButton" = "Playback Speed for All Music";
"SuperGram.Network.MutePresets" = "More Mute Durations";
"SuperGram.Network.SessionIP" = "Show IP of Active Sessions";
"SuperGram.Network.SessionIP.Notice" = "Playback Speed for All Music shows the speed button in the music player for short tracks too. More Mute Durations adds 4 hours, 8 hours and 1 day to the mute menu. Show IP of Active Sessions displays the IP address of your Telegram sessions, which Telegram normally hides.";

/* W2-CHATUI-INPUT */
"SuperGram.ChatUI.Input.Header" = "INPUT PANEL";
"SuperGram.ChatUI.Input.RecordingTooltip" = "\"Hold to Record\" Tooltip";
"SuperGram.ChatUI.Input.Buttons.Notice" = "With the Voice Recording Button off, the send button is always visible and voice messages and video messages can no longer be recorded from this chat. The other switches only hide buttons.";
