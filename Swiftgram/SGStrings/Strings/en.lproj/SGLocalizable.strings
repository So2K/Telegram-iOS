"SuperGram.App.Header" = "APP";
"SuperGram.App.BackgroundKeepAlive" = "Keep Connection in Background";
"SuperGram.App.BackgroundKeepAlive.Notice" = "Uses a silent audio track to keep receiving messages and showing local notifications in the background. It stops after a period without new messages or network access, even while charging. Low Power Mode or high device temperature shortens the idle period; critical heat pauses this notification fallback. Active downloads, audio and calls use separate background controls. This can use extra battery. iOS may still suspend the app, so this does not replace push notifications.";
"SuperGram.App.PerformanceMode" = "Performance Mode";
"SuperGram.App.PlayVideoInBackground" = "Background Video Playback";
"SuperGram.App.PerformanceMode.Notice" = "Performance Mode turns off looping animated emoji and translucency effects to save battery.";
"SuperGram.App.DisableReadMetrics" = "Don't Send Reading Statistics";
