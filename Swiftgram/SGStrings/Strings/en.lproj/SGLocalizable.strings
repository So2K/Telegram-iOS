"SuperGram.ChatUI.Input.Toolbar" = "Formatting Panel";
"SuperGram.ChatUI.Input.Toolbar.Notice" = "A row of formatting buttons above the keyboard: bold, italic, underline, strikethrough, monospace, code block, quote, spoiler, link, date and line break. With nothing selected, a button formats the word before the cursor. Applies to chats you open afterwards.";
"SuperGram.ChatUI.Input.ChannelPanel.Notice" = "The channel bottom panel holds Join, Mute and Unmute. Turning it off gives channels you already follow more reading space; it stays visible while you search or select messages.";
"SuperGram.ChatUI.Input.Keyboard.Header" = "EMOJI KEYBOARD";
"SuperGram.ChatUI.Input.Keyboard.Notice" = "Emoji tab first always opens the media keyboard on Emoji and removes the sticker shortcut from the input panel. Standard emojis first moves the plain emoji set ahead of custom and premium packs.";
"SuperGram.ChatUI.Input.Stickers.Header" = "STICKERS";
