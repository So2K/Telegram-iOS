+bool ZBundle::PrepareStrictSigning(const string& folder, const set<string>& identifiers)
+{
+    m_bStrictSigning = true;
+    m_setStrictExecutables.clear();
+    m_setStrictProfileIds.clear();
+    m_mapStrictAssets.clear();
+    m_strStrictMainId.clear();
+    m_strStrictRootPath.clear();
+    if (!ZFile::IsFolder(folder.c_str()) || !ZFile::IsPathSuffix(folder, ".app") || identifiers.empty())
+        return ZLog::Error(">>> Strict mode requires a staged .app and nonempty mappings!\n");
+    if (!ZStrictCanonicalPath(folder, m_strStrictRootPath)) return false;
+    m_strAppFolder = folder;
+    jvalue root;
+    root["path"] = "/";
+    if (!GetSignFolderInfo(folder, root) || !GetObjectsToSign(folder, root)) return false;
+    m_strStrictMainId = root["bundle_id"].as_string();
+    vector<jvalue> nodes{root};
+    for (size_t i = 0; i < root["folders"].size(); ++i) nodes.push_back(root["folders"][i]);
+    for (const jvalue& node : nodes) {
+        const string path = node["path"].as_string();
+        const string relative = (path == "/" ? "" : path + "/") + node["bundle_executable"].as_string();
+        string canonical;
+        if (!ZStrictContainedCode(m_strStrictRootPath, folder + "/" + relative, canonical) ||
+            !m_setStrictExecutables.insert(canonical).second) return false;
+        ZMachO macho;
+        if (!macho.Init((folder + "/" + relative).c_str())) return false;
+        const bool profileBundle = path == "/" || ZFile::IsPathSuffix(path, ".app") || ZFile::IsPathSuffix(path, ".appex");
+        const string base = path == "/" ? folder : folder + "/" + path;
+        if (!CheckStrictOutputs(base, profileBundle)) return false;
+        if (profileBundle) {
+            if (!macho.IsExecute() || !m_setStrictProfileIds.insert(node["bundle_id"].as_string()).second)
+                return ZLog::Error(">>> Strict mode found duplicate or invalid application executables!\n");
+        } else if (macho.HasExecute()) {
+            return ZLog::Error(">>> Strict mode found an unclassified MH_EXECUTE bundle!\n");
+        }
+    }
+    if (m_setStrictProfileIds != identifiers) return ZLog::Error(">>> Strict bundle mappings are missing or unused!\n");
+    for (size_t i = 0; i < root["files"].size(); ++i) {
+        const string relative = root["files"][i].as_string();
+        string canonical;
+        if (!ZStrictContainedCode(m_strStrictRootPath, folder + "/" + relative, canonical)) return false;
+        if (m_setStrictExecutables.count(canonical)) continue;
+        ZMachO macho;
+        if (!macho.Init((folder + "/" + relative).c_str()) || macho.HasExecute())
+            return ZLog::Error(">>> Strict mode found an unclassified MH_EXECUTE file!\n");
+    }
+    return true;
+}
+
+bool ZBundle::ValidateStrictResources()
+{
+    // This path performs no profile installation, asset initialization or signing.
+    if (!m_bStrictSigning || m_strAppFolder.empty() || m_bRemoveProvision) return false;
+    jvalue root;
+    root["path"] = "/";
+    if (!GetSignFolderInfo(m_strAppFolder, root) || !GetObjectsToSign(m_strAppFolder, root)) return false;
+    vector<string> folders{m_strAppFolder};
+    for (size_t i = 0; i < root["folders"].size(); ++i)
+        folders.push_back(m_strAppFolder + "/" + root["folders"][i]["path"].as_string());
+    for (const string& folder : folders) {
+        jvalue resources;
+        if (!GenerateCodeResources(folder, resources)) return false;
+    }
+    return true;
+}
+
+bool ZBundle::SetStrictSignAssets(const map<string, ZSignAsset*>& assets)
+{
+    set<string> identifiers;
+    string certificate, team;
+    for (const auto& entry : assets) {
+        ZSignAsset* asset = entry.second;
+        if (!asset || asset->m_bAdhoc || asset->m_strTeamId.empty() ||
+            asset->m_strApplicationId != asset->m_strTeamId + "." + entry.first || asset->m_strLeafCertificateData.empty())
+            return ZLog::Error(">>> Strict mode requires exact initialized bundle assets!\n");
+        if (certificate.empty()) { certificate = asset->m_strLeafCertificateData; team = asset->m_strTeamId; }
+        if (certificate != asset->m_strLeafCertificateData || team != asset->m_strTeamId) return ZLog::Error(">>> Strict bundle signing certificates differ!\n");
+        identifiers.insert(entry.first);
+    }
+    if (!m_bStrictSigning || identifiers != m_setStrictProfileIds || !identifiers.count(m_strStrictMainId)) return false;
+    m_mapStrictAssets = assets;
+    return true;
+}
