+// Opt-in policy helpers: no key access, logging of profile contents or signing.
+struct ZStrictBundleSpec {
+    string bundleId;
+    string profilePath;
+    string entitlementsPath;
+};
+
+inline bool ZStrictBundleId(const string& value)
+{
+    if (value.empty() || value.front() == '.' || value.back() == '.') return false;
+    char previous = 0;
+    for (unsigned char c : value) {
+        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+              (c >= '0' && c <= '9') || c == '-' || c == '.')) return false;
+        if (c == '.' && previous == '.') return false;
+        previous = c;
+    }
+    return true;
+}
+
+inline bool ZStrictReadFile(const string& path, size_t limit, string& result)
+{
+    result.clear();
+    FILE* file = NULL;
+    struct stat info;
+#ifdef _WIN32
+    file = fopen(path.c_str(), "rb");
+    if (!file) return false;
+    const bool admitted = fstat(fileno(file), &info) == 0;
+#else
+    const int descriptor = open(path.c_str(), O_RDONLY | O_NONBLOCK);
+    if (descriptor < 0) return false;
+    if (fstat(descriptor, &info) != 0 || !S_ISREG(info.st_mode)) { close(descriptor); return false; }
+    file = fdopen(descriptor, "rb");
+    if (!file) { close(descriptor); return false; }
+    const bool admitted = true;
+#endif
+    bool valid = admitted && S_ISREG(info.st_mode) && info.st_size > 0 && uint64_t(info.st_size) <= limit;
+    char buffer[4096];
+    while (valid) {
+        const size_t count = fread(buffer, 1, min(sizeof(buffer), limit + 1 - result.size()), file);
+        result.append(buffer, count);
+        if (result.size() > limit || ferror(file)) { valid = false; break; }
+        if (!count) break;
+    }
+    fclose(file);
+    return valid && !result.empty();
+}
+
+// Strict signing writes code only inside the preflighted staging root.
+inline bool ZStrictCanonicalPath(const string& path, string& result)
+{
+    result.clear();
+#ifdef _WIN32
+    return false;
+#else
+    char resolved[PATH_MAX];
+    if (!realpath(path.c_str(), resolved)) return false;
+    result = resolved;
+    return true;
+#endif
+}
+
+inline bool ZStrictContainedCode(const string& root, const string& path, string& resolved)
+{
+    struct stat info;
+    return !root.empty() && ZStrictCanonicalPath(path, resolved) && resolved.size() > root.size() &&
+           resolved.compare(0, root.size(), root) == 0 && resolved[root.size()] == '/' &&
+           stat(resolved.c_str(), &info) == 0 && S_ISREG(info.st_mode) && info.st_nlink == 1;
+}
+
+inline bool ZStrictContainedOutput(const string& root, const string& path, bool directory)
+{
+    if (root.empty() || path.empty()) return false;
+#ifdef _WIN32
+    return false;
+#else
+    struct stat leaf;
+    // Known output aliases can overwrite admitted code or Info.plist inside the root.
+    if (lstat(path.c_str(), &leaf) == 0 && S_ISLNK(leaf.st_mode)) return false;
+    string cursor = path;
+    bool original = true;
+    for (;;) {
+        string resolved;
+        struct stat info;
+        if (ZStrictCanonicalPath(cursor, resolved)) {
+            const bool inside = resolved == root || (resolved.size() > root.size() &&
+                resolved.compare(0, root.size(), root) == 0 && resolved[root.size()] == '/');
+            if (!inside || stat(resolved.c_str(), &info) != 0) return false;
+            return original ? (directory ? S_ISDIR(info.st_mode) : (S_ISREG(info.st_mode) && info.st_nlink == 1)) : S_ISDIR(info.st_mode);
+        }
+        // A dangling or otherwise unresolvable existing link is never a fresh output.
+        if (lstat(cursor.c_str(), &info) == 0 || errno != ENOENT) return false;
+        const size_t separator = cursor.find_last_of('/');
+        if (separator == string::npos || separator == 0) return false;
+        cursor.erase(separator);
+        original = false;
+    }
