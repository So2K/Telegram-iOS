+}
+
+inline void ZStrictWhitespace(const string& text, size_t& position)
+{
+    while (position < text.size() && (text[position] == ' ' || text[position] == '\t' || text[position] == '\r' || text[position] == '\n')) ++position;
+}
+
+inline bool ZStrictJsonString(const string& text, size_t& position, string& value)
+{
+    ZStrictWhitespace(text, position);
+    const size_t begin = position;
+    if (position == text.size() || text[position++] != '"') return false;
+    while (position < text.size()) {
+        const unsigned char c = text[position++];
+        if (c < 32) return false;
+        if (c == '"') {
+            jvalue decoded;
+            if (!decoded.read(text.substr(begin, position - begin)) || !decoded.is_string()) return false;
+            value = decoded.as_string();
+            return true;
+        }
+        if (c != '\\') continue;
+        if (position == text.size()) return false;
+        const char escape = text[position++];
+        if (escape == 'u') {
+            if (text.size() - position < 4) return false;
+            const string code = text.substr(position, 4);
+            if (code.find_first_not_of("0123456789abcdefABCDEF") != string::npos) return false;
+            const unsigned long scalar = strtoul(code.c_str(), NULL, 16);
+            if (scalar == 0 || (scalar >= 0xd800 && scalar <= 0xdfff)) return false;
+            position += 4;
+        } else if (string("\"\\/bfnrt").find(escape) == string::npos) return false;
+    }
+    return false;
+}
+
+inline bool ZStrictJsonCharacter(const string& text, size_t& position, char expected)
+{
+    ZStrictWhitespace(text, position);
+    if (position == text.size() || text[position] != expected) return false;
+    ++position;
+    return true;
+}
+
+inline bool ZStrictParseManifest(const string& text, const string& directory,
+                                vector<ZStrictBundleSpec>& result)
+{
+    result.clear();
+    if (text.empty() || text.size() > 65536) return false;
+    size_t position = 0;
+    if (!ZStrictJsonCharacter(text, position, '[')) return false;
+    set<string> identifiers;
+    for (;;) {
+        if (result.size() >= 64 || !ZStrictJsonCharacter(text, position, '{')) return false;
+        map<string, string> fields;
+        for (;;) {
+            string key, value;
+            if (!ZStrictJsonString(text, position, key) || !ZStrictJsonCharacter(text, position, ':') ||
+                !ZStrictJsonString(text, position, value) || !fields.emplace(key, value).second) return false;
+            ZStrictWhitespace(text, position);
+            if (position == text.size()) return false;
+            if (text[position] == '}') { ++position; break; }
+            if (!ZStrictJsonCharacter(text, position, ',')) return false;
+        }
+        if (fields.size() != 3 || !fields.count("bundle_id") || !fields.count("profile_path") || !fields.count("entitlements_path")) return false;
+        ZStrictBundleSpec spec{fields["bundle_id"], fields["profile_path"], fields["entitlements_path"]};
+        if (!ZStrictBundleId(spec.bundleId) || !identifiers.insert(spec.bundleId).second ||
+            spec.profilePath.empty() || spec.entitlementsPath.empty()) return false;
+        if (spec.profilePath.front() != '/') spec.profilePath = directory + "/" + spec.profilePath;
+        if (spec.entitlementsPath.front() != '/') spec.entitlementsPath = directory + "/" + spec.entitlementsPath;
+        result.push_back(spec);
+        ZStrictWhitespace(text, position);
+        if (position == text.size()) return false;
+        if (text[position] == ']') { ++position; break; }
+        if (!ZStrictJsonCharacter(text, position, ',')) return false;
+    }
+    ZStrictWhitespace(text, position);
+    return position == text.size();
+}
+
+inline bool ZStrictEntitlementAllowed(const jvalue& value, const jvalue& grant)
+{
+    if (value.type() != grant.type()) return false;
+    if (value.is_string()) {
+        const string requested = value.as_string(), permission = grant.as_string();
+        if (requested.find('*') != string::npos) return false;
+        if (requested == permission) return true;
+        const size_t wildcard = permission.find('*');
+        return wildcard != string::npos && wildcard == permission.size() - 1 &&
+               requested.compare(0, wildcard, permission, 0, wildcard) == 0;
+    }
+    if (value.is_array()) {
+        for (size_t i = 0; i < value.size(); ++i) {
+            bool allowed = false;
+            for (size_t j = 0; j < grant.size(); ++j) {
+                if (ZStrictEntitlementAllowed(value[i], grant[j])) { allowed = true; break; }
+            }
+            if (!allowed) return false;
+        }
+        return true;
+    }
+    if (value.is_object()) {
+        vector<string> keys;
+        value.get_keys(keys);
+        for (const string& key : keys) {
+            if (!grant.has(key) || !ZStrictEntitlementAllowed(value[key], grant[key])) return false;
+        }
+        return true;
+    }
+    if (value.is_bool()) return value.as_bool() == grant.as_bool();
+    if (value.is_int()) return value.as_int64() == grant.as_int64();
+    if (value.is_double()) return value.as_double() == grant.as_double();
+    if (value.is_data()) return value.as_data() == grant.as_data();
+    if (value.is_date()) return value.as_date() == grant.as_date();
+    return false;
+}
+
+inline bool ZStrictCertificateMetadata(const jvalue& profile)
+{
+    const jvalue& certificates = profile["DeveloperCertificates"];
+    if (!certificates.is_array() || certificates.size() == 0) return false;
+    for (size_t i = 0; i < certificates.size(); ++i)
+        if (!certificates[i].is_data() || certificates[i].as_data().empty()) return false;
+    return true;
+}
+
+inline bool ZStrictValidateEntitlements(const jvalue& profile, const jvalue& entitlements,
+                                       const string& bundleId)
+{
+    const jvalue& teams = profile["TeamIdentifier"];
+    const jvalue& grants = profile["Entitlements"];
+    if (!ZStrictCertificateMetadata(profile) || !ZStrictBundleId(bundleId) || !teams.is_array() || teams.size() != 1 ||
+        !teams[0].is_string() || teams[0].as_string().empty() ||
+        !grants.is_object() || !entitlements.is_object() || entitlements.size() == 0) return false;
+    const string team = teams[0].as_string();
+    const string appId = team + "." + bundleId;
+    for (const jvalue* values : {&grants, &entitlements}) {
+        if (!(*values)["application-identifier"].is_string() || (*values)["application-identifier"].as_string() != appId ||
+            !(*values)["com.apple.developer.team-identifier"].is_string() || (*values)["com.apple.developer.team-identifier"].as_string() != team ||
+            !(*values)["get-task-allow"].is_bool() || (*values)["get-task-allow"].as_bool()) return false;
+    }
+    return ZStrictEntitlementAllowed(entitlements, grants);
+}
+
+inline bool ZStrictLeafCertificateAllowed(const jvalue& profile, const string& certificateDER)
+{
+    const jvalue& certificates = profile["DeveloperCertificates"];
+    if (certificateDER.empty() || !ZStrictCertificateMetadata(profile)) return false;
+    for (size_t i = 0; i < certificates.size(); ++i) {
+        if (certificates[i].as_data() == certificateDER) return true;
+    }
+    return false;
+}
